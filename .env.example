# Copia questo file in ".env" e inserisci la tua chiave Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Modello da usare per l'interpretazione (default: claude-haiku-4-5-20251001,
# più economico di Sonnet; per una precisione leggermente superiore su
# cedolini con layout complessi puoi passare a claude-sonnet-5)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
